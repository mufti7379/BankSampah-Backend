# ================================================================
# BankSampahKu - Variabel Lingkungan (Environment Variables)
# ================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN commit file .env ke repository!
# ================================================================

# ==== Aplikasi ====
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
# Zona waktu bisnis untuk menentukan "hari ini" (harga aktif, tanggal penimbangan)
APP_TIMEZONE=Asia/Jakarta

# ==== CORS ====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==== Database PostgreSQL ====
DATABASE_URL=postgres://banksampahku:secret@localhost:5432/banksampahku?sslmode=disable
# Jalankan migrasi "up" otomatis saat server start (disarankan false di production)
DB_AUTO_MIGRATE=true

# ==== JWT ====
JWT_SECRET=ubah-ini-menjadi-random-string-minimal-64-karakter-yang-sangat-aman
JWT_EXPIRED_HOURS=168

# ==== Keamanan Password ====
# Pepper HMAC sebelum bcrypt (minimal 32 karakter). Generate: openssl rand -hex 32
# JANGAN diubah setelah ada user, semua password jadi tidak valid!
PASSWORD_PEPPER=ubah-ini-menjadi-random-hex-64-karakter

# ==== Rate Limiter ====
RATE_LIMIT_PER_MINUTE=120
# Batas lebih ketat per IP untuk endpoint /api/v1/auth/* (login, register, lupa password)
AUTH_RATE_LIMIT_PER_MINUTE=20
# IP reverse proxy yang dipercaya (pisah koma). Kosongkan jika API diakses langsung.
# Contoh di belakang Nginx lokal: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCK_MINUTES=15

# ==== QR Code ====
QR_PREFIX=BSK-

# ==== Email (SMTP) ====
# Kosongkan SMTP_HOST di development: email hanya dicetak ke log server.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD=<App Password 16 digit>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@banksampahku.id
SMTP_FROM_NAME=BankSampahKu

# ==== Reset Password ====
# URL halaman reset di frontend web; token ditambahkan otomatis sebagai ?token=...
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=30
